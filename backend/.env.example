APP_NAME=AutoEvolve
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://backend.example.com
FRONTEND_URL=https://your-vercel-site.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Production source of truth: MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=

# Store runtime state in MySQL too
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

ADMIN_EMAIL=
ADMIN_PASSWORD=
