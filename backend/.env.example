APP_NAME=AutoEvolve
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://autoevolve.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Production source of truth: MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=

# SaaS runtime state also stays in MySQL
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# Stripe subscriptions
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

ADMIN_EMAIL=
ADMIN_PASSWORD=
